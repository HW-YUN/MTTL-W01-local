# MTTL-W01 HA MQTT bridge — environment template.
#
# Copy to /etc/mttl/ha-bridge.env on the bridge host, fill in the HA broker
# values, and  chmod 600 /etc/mttl/ha-bridge.env  (root:root).
# Do NOT commit a filled-in copy. This file has placeholders only.
#
# The bridge does nothing destructive if HA values are missing — it logs an
# error and idles (observer + devices.json still polled, nothing published).

# ---- HA Mosquitto broker (values UNKNOWN until deploy — do not guess) --------
MTTL_HA_MQTT_HOST=
MTTL_HA_MQTT_PORT=1883
MTTL_HA_MQTT_USERNAME=
MTTL_HA_MQTT_PASSWORD=
MTTL_HA_MQTT_TLS=0
# MTTL_HA_MQTT_CA=/etc/mttl/ha-ca.pem      # only if TLS + self-signed
MTTL_HA_MQTT_CLIENT_ID=mttl-ha-bridge
MTTL_HA_MQTT_PREFIX=mttl
MTTL_HA_DISCOVERY_PREFIX=homeassistant

# ---- relay side (already on this host) --------------------------------------
MTTL_OBSERVER=127.0.0.1:9883
MTTL_STATE_FILE=/srv/mttl-lab/relay/state/devices.json

# ---- behaviour -------------------------------------------------------------
MTTL_HA_GRACE_SECONDS=45

# STATUS_GET reconciliation interval, in seconds.
#   code default : 0  (OFF — no periodic STATUS_GET from the bridge)
#   verified/recommended deployment value : 30
# When set > 0 the bridge owns periodic reconciliation and the dashboard's own
# auto STATUS_GET should be turned off (MTTL_STATUS_INTERVAL=0 on the dashboard)
# so the two do not both poll.
MTTL_HA_STATUS_INTERVAL=30

# FUTURE: one STATUS_GET N seconds after a command. v1 = 0 (OFF).
MTTL_HA_POST_CMD_STATUS_DELAY=0

MTTL_HA_CONFIRM_TIMEOUT=10

# MTTL_HA_LOG_LEVEL=INFO
